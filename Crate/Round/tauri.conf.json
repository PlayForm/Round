{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Round",
	"version": "0.0.9",
	"identifier": "app.roundedcorners.binary",
	"build": {
		"beforeBuildCommand": "pnpm run Build",
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"frontendDist": "../../Package/Web/Target"
	},
	"app": {
		"macOSPrivateApi": true,
		"security": {
			"assetProtocol": {
				"enable": false,
				"scope": []
			},
			"capabilities": [],
			"csp": null,
			"dangerousDisableAssetCspModification": false,
			"freezePrototype": false,
			"pattern": {
				"use": "brownfield"
			}
		},
		"windows": [],
		"withGlobalTauri": false
	},
	"bundle": {
		"active": true,
		"android": {
			"minSdkVersion": 24
		},
		"category": "Utility",
		"copyright": "Copyright (c) 2022-2026 Nikola Hristov. All rights reserved.",
		"externalBin": [],
		"iOS": {},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"appimage": {
				"bundleMediaFramework": false,
				"files": {}
			},
			"deb": {
				"files": {}
			},
			"rpm": {
				"epoch": 0,
				"files": {},
				"release": "1"
			}
		},
		"longDescription": "Round draws rounded corners over every connected monitor: one transparent, click-through overlay per screen, controlled from the system tray.",
		"macOS": {
			"dmg": {
				"appPosition": {
					"x": 0,
					"y": 0
				},
				"applicationFolderPosition": {
					"x": 0,
					"y": 0
				},
				"windowSize": {
					"height": 400,
					"width": 660
				}
			},
			"files": {},
			"hardenedRuntime": false,
			"minimumSystemVersion": "10.13",
			"signingIdentity": "-"
		},
		"resources": [],
		"shortDescription": "Rounded corners on every monitor.",
		"targets": "all",
		"windows": {
			"allowDowngrades": false,
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"nsis": null,
			"timestampUrl": null,
			"tsp": true,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			},
			"wix": {
				"bannerPath": "Source/Image/banner.png",
				"dialogImagePath": "Source/Image/dialogImage.png"
			}
		}
	}
}
