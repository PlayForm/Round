{
	"name": "@application/round",
	"version": "0.0.11",
	"private": true,
	"description": "Repository root: the Rust crate lives in Crate/Round, the webview frontend in Package/Web.",
	"homepage": "https://github.com/PlayForm/Round#readme",
	"bugs": {
		"url": "https://github.com/PlayForm/Round/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PlayForm/Round.git"
	},
	"license": "CC0-1.0",
	"author": {
		"name": "Source ✍🏻 Open 👐🏻",
		"email": "Source/Open@PlayForm.Cloud",
		"url": "https://PlayForm.Cloud"
	},
	"type": "module",
	"scripts": {
		"Build": "pnpm --filter @application/round-web run Build",
		"Check": "cargo run --quiet -p round-maintain -- check",
		"Version": "cargo run --quiet -p round-maintain -- version",
		"dev": "pnpm --filter @application/round-web run dev",
		"serve": "pnpm --filter @application/round-web run serve",
		"start": "pnpm --filter @application/round-web run dev",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.6"
	},
	"packageManager": "pnpm@12.16.1",
